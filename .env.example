# LocalPulse AI Environment Configuration

# Server Port (default 3001)
PORT=3001

# Gemini API Key (Required for live Gemini 3.8 Flash model execution)
# Get a free key at: https://aistudio.google.com/
GEMINI_API_KEY=

# data.gov.in Mandi Market Price API Key (Optional)
# If missing, historical Visakhapatnam benchmarks are served safely
DATA_GOV_IN_API_KEY=

# Firebase Client Configuration (Optional for Cloud; Default: Local Emulator)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=localpulse-ai-demo
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Firebase Emulator Hosts (Set to true to route SDK to local emulators)
VITE_USE_FIREBASE_EMULATOR=true
FIREBASE_AUTH_EMULATOR_HOST=localhost:9099
FIRESTORE_EMULATOR_HOST=localhost:8080
FIREBASE_STORAGE_EMULATOR_HOST=localhost:9199

# Firebase Admin SDK Service Account JSON Path (Optional in emulator mode)
# GOOGLE_APPLICATION_CREDENTIALS=./service-account.json
