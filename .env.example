# LocalPulse AI Environment Configuration

# Server Port (default 3001)
PORT=3001

# Gemini API Key (Required for live Gemini 3.8 Flash model execution)
# Get a free key at: https://aistudio.google.com/
GEMINI_API_KEY=

# data.gov.in Mandi Market Price API Key (Optional)
# If missing, historical Visakhapatnam benchmarks are served safely
DATA_GOV_IN_API_KEY=

# Firebase Production Project Configuration (Firebase Project ID: localpulse-ai-a990f)
FIREBASE_PROJECT_ID=localpulse-ai-a990f
VITE_FIREBASE_PROJECT_ID=localpulse-ai-a990f
VITE_FIREBASE_AUTH_DOMAIN=localpulse-ai-a990f.firebaseapp.com
VITE_FIREBASE_STORAGE_BUCKET=localpulse-ai-a990f.firebasestorage.app
FIREBASE_STORAGE_BUCKET=localpulse-ai-a990f.firebasestorage.app
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Firebase Emulator Controls (Keep separate and intentional)
# Set to 'true' to route client/server SDKs to local emulator suite; leave 'false' for live cloud
USE_FIREBASE_EMULATOR=false
VITE_USE_FIREBASE_EMULATOR=false
FIREBASE_AUTH_EMULATOR_HOST=localhost:9099
FIRESTORE_EMULATOR_HOST=localhost:8080
FIREBASE_STORAGE_EMULATOR_HOST=localhost:9199

# Firebase Admin SDK Service Account JSON Path (Required only for live backend cloud operations)
# GOOGLE_APPLICATION_CREDENTIALS=./service-account.json
